<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

  <changeSet author="traccar" id="device-block-state">
    <addColumn tableName="tc_devices">
      <column name="blockState" type="VARCHAR(16)" defaultValue="unknown">
        <constraints nullable="false" />
      </column>
      <column name="blockStateTime" type="TIMESTAMP" />
      <column name="blockRequestedState" type="VARCHAR(16)" />
      <column name="blockRequestedTime" type="TIMESTAMP" />
      <column name="blockRequestStatus" type="VARCHAR(16)" />
      <column name="blockRequestId" type="VARCHAR(36)" />
    </addColumn>
  </changeSet>

</databaseChangeLog>
